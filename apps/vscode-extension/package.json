{
  "name": "@tmpt/vscode-extension",
  "displayName": "TMTP",
  "description": "Project-aware onboarding: visualizes what TMTP's deterministic scanner discovers about your codebase.",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tmtp",
          "title": "TMTP",
          "icon": "media/tmtp.svg"
        }
      ]
    },
    "views": {
      "tmtp": [
        {
          "id": "tmtp.home",
          "name": "Learning Home",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "tmtp.showOverview",
        "title": "TMTP: Show Project Overview"
      }
    ]
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "test:integration": "node --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@tmpt/scanner": "workspace:*",
    "@tmpt/ai": "workspace:*",
    "@xyflow/react": "^12.3.6",
    "elkjs": "^0.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.85.0",
    "esbuild": "0.21.5",
    "jsdom": "^25.0.1",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3"
  }
}
